# --------------------------- TypeSafe (internet) ------------------------------
# Clave de https://console.typesafe.ai/keys. Vive solo en el servidor: el
# navegador nunca la ve, todo pasa por POST /api/decision.
TYPESAFE_API_KEY=

# Endpoint de la API System One de TypeSafe.
TYPESAFE_URL=https://api.typesafe.ai

# Modelo por defecto (jev-latest es el alias estable).
TYPESAFE_MODEL=jev-latest

# Corte de seguridad para una decision lenta.
TYPESAFE_TIMEOUT_MS=30000

# Logs de terminal. debug | info | warn | error | silent. info ya cuenta cada
# decision con su latencia y su resultado; debug anade detalles de cada vuelo.
LOG_LEVEL=info

# 1 para volcar el prompt completo y las jugadas de cada decision (nivel debug).
LOG_PROMPTS=0

# Los colores se apagan solos cuando la salida no es una terminal o con NO_COLOR=1.

# --------------------------- MongoDB (partidas) -------------------------------
# Historico de rondas. Todo cae en UNA sola coleccion: `matches`.
# Levanta la base con `docker compose up -d` (mongo :27017, express :8081).
# Sin MONGO_URL la persistencia queda apagada y el juego sigue igual: nunca
# tumba una partida.
MONGO_URL=mongodb://jev:jevpass@localhost:27017/nimble?authSource=admin

# Base de datos donde vive la coleccion `matches`.
MONGO_DB=nimble
