# Servidor de Ollama. Por defecto apunta al local.
OLLAMA_URL=http://127.0.0.1:11434

# Modelo por defecto cuando el cliente no manda uno.
OLLAMA_MODEL=nimble

# Corte de seguridad para una decision lenta.
OLLAMA_TIMEOUT_MS=30000

# auto = intenta el modelo y cae al heuristico local si falla.
# model = solo modelo. heuristic = solo heuristico (sin LLM).
DECISION_STRATEGY=auto
