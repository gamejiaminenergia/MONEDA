# TypeSafe (System One)
TYPESAFE_API_KEY=
TYPESAFE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_MS=30000

# MongoDB (historico del juego)
MONGO_URL=
MONGO_DB=nimble
MONGO_COLLECTION=sessions

# PostgreSQL de XM (skill elecdb)
ELECDB_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Subconjunto del MEM que se juega
SUBSET_GENERATORS=12
SUBSET_COMERCIALIZADORES=10

# CORS (origenes separados por coma)
CORS_ORIGINS=*
