{
  "name": "nimble-pong",
  "version": "0.2.0",
  "description": "Have No Mouth, and I Must Scream IA: pong de diez jugadores con nombre de color donde cada jugada la decide la API System One de TypeSafe. Un roce y el jugador muere; gana el ultimo que siga vivo.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nextjs",
    "typescript",
    "typesafe",
    "llm",
    "pong",
    "planck",
    "box2d",
    "phaser",
    "canvas"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "next": "16.3.8",
    "phaser": "^4.2.1",
    "planck": "^1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
